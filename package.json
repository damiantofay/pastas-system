{
  "name": "fabrica-pastas",
  "version": "1.0.0",
  "description": "Sistema de gestion para fabrica de pastas familiar (MVP nucleo operativo)",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
